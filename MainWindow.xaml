<Window x:Class="LumaLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LumaLab" Width="1400" Height="900" Background="#111111" Foreground="#E9E9E9"><Grid><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><Border Grid.Row="0" Grid.ColumnSpan="3" Background="#181818"><DockPanel Margin="18,0"><TextBlock Text="LumaLab" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="OPEN" Click="Open_Click" Margin="6" Padding="18,8"/><Button Content="RESET" Click="Reset_Click" Margin="6" Padding="18,8"/><Button Content="EXPORT" Click="Export_Click" Margin="6" Padding="18,8"/></StackPanel></DockPanel></Border><Border Grid.Row="1" Grid.Column="0" Background="#181818" Padding="14"><StackPanel><TextBlock Text="LIBRARY" Foreground="#888" FontSize="11" Margin="4,8,0,12"/><Button Content="All Photos" HorizontalContentAlignment="Left" Padding="12,9"/><Button Content="Recently Added" HorizontalContentAlignment="Left" Padding="12,9"/><Separator Margin="0,14"/><TextBlock Text="TOOLS" Foreground="#888" FontSize="11" Margin="4,8,0,12"/><Button Content="Crop &amp; Rotate" HorizontalContentAlignment="Left" Padding="12,9"/><Button Content="Color" HorizontalContentAlignment="Left" Padding="12,9"/><Button Content="Detail" HorizontalContentAlignment="Left" Padding="12,9"/></StackPanel></Border><Border Grid.Row="1" Grid.Column="1" Background="#0E0E0E" Padding="20"><Grid><TextBlock x:Name="EmptyText" Text="Open a photo to begin" Foreground="#666" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Preview" Stretch="Uniform" Visibility="Collapsed"/></Grid></Border><ScrollViewer Grid.Row="1" Grid.Column="2" Background="#181818" Padding="18"><StackPanel><TextBlock Text="EDIT" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="Exposure"/><Slider x:Name="Exposure" Minimum="-2" Maximum="2" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Contrast"/><Slider x:Name="Contrast" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Highlights"/><Slider x:Name="Highlights" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Shadows"/><Slider x:Name="Shadows" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Whites"/><Slider x:Name="Whites" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Blacks"/><Slider x:Name="Blacks" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><Separator Margin="0,20"/><TextBlock Text="Temperature"/><Slider x:Name="Temperature" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Tint"/><Slider x:Name="Tint" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Saturation"/><Slider x:Name="Saturation" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Vibrance"/><Slider x:Name="Vibrance" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/></StackPanel></ScrollViewer><Border Grid.Row="2" Grid.ColumnSpan="3" Background="#181818"><DockPanel Margin="16,0"><TextBlock x:Name="Status" Text="Ready" Foreground="#888" VerticalAlignment="Center"/><TextBlock Text="LumaLab • Windows" Foreground="#888" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border></Grid></Window>