<Window x:Class="LumaLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LumaLab" Width="1400" Height="900" Background="#111111" Foreground="#E9E9E9">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
<Border Grid.Row="0" Grid.ColumnSpan="3" Background="#181818"><DockPanel Margin="18,0"><TextBlock Text="LumaLab" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="OPEN" Click="Open_Click" Margin="6" Padding="18,8"/><Button Content="RESET" Click="Reset_Click" Margin="6" Padding="18,8"/><Button Content="EXPORT" Click="Export_Click" Margin="6" Padding="18,8"/></StackPanel></DockPanel></Border>
<Border Grid.Row="1" Grid.Column="0" Background="#181818" Padding="14"><StackPanel><TextBlock Text="LIBRARY" Foreground="#888" FontSize="11" Margin="4,8,0,12"/><Button Content="All Photos" HorizontalContentAlignment="Left" Padding="12,9"/><Button Content="Recently Added" HorizontalContentAlignment="Left" Padding="12,9"/><Separator Margin="0,14"/><TextBlock Text="TOOLS" Foreground="#888" FontSize="11" Margin="4,8,0,12"/><Button Content="Crop &amp; Rotate" HorizontalContentAlignment="Left" Padding="12,9"/><Button Content="Color" HorizontalContentAlignment="Left" Padding="12,9"/><Button Content="Detail" HorizontalContentAlignment="Left" Padding="12,9"/><Button x:Name="BrushTool" Content="Brush Mask" Click="BrushTool_Click" HorizontalContentAlignment="Left" Padding="12,9"/></StackPanel></Border>
<Border Grid.Row="1" Grid.Column="1" Background="#0E0E0E" Padding="20"><Grid x:Name="CanvasHost" ClipToBounds="True"><TextBlock x:Name="EmptyText" Text="Open a photo to begin" Foreground="#666" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Preview" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/><Image x:Name="MaskOverlay" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.45"/><Canvas x:Name="PaintSurface" Background="Transparent" Visibility="Collapsed" MouseLeftButtonDown="PaintSurface_MouseLeftButtonDown" MouseMove="PaintSurface_MouseMove" MouseLeftButtonUp="PaintSurface_MouseLeftButtonUp" MouseLeave="PaintSurface_MouseLeave" Cursor="Pen"/><Ellipse x:Name="BrushCursor" Width="80" Height="80" Stroke="#FFFF5555" StrokeThickness="1.5" Fill="#22FF3333" Visibility="Collapsed" IsHitTestVisible="False"/></Grid></Border>
<ScrollViewer Grid.Row="1" Grid.Column="2" Background="#181818" Padding="18"><StackPanel><TextBlock Text="EDIT" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="Exposure"/><Slider x:Name="Exposure" Minimum="-2" Maximum="2" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Contrast"/><Slider x:Name="Contrast" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Highlights"/><Slider x:Name="Highlights" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Shadows"/><Slider x:Name="Shadows" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Whites"/><Slider x:Name="Whites" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Blacks"/><Slider x:Name="Blacks" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><Separator Margin="0,20"/><TextBlock Text="Temperature"/><Slider x:Name="Temperature" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Tint"/><Slider x:Name="Tint" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Saturation"/><Slider x:Name="Saturation" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/><TextBlock Text="Vibrance"/><Slider x:Name="Vibrance" Minimum="-100" Maximum="100" Value="0" ValueChanged="Slider_Changed"/>
<Separator Margin="0,20"/><TextBlock Text="MASKING" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/><Button x:Name="BrushButton" Content="BRUSH" Click="BrushTool_Click" Padding="10" Margin="0,0,0,7"/><WrapPanel><Button Content="OVERLAY" Click="ShowMask_Click" Padding="8" Margin="0,0,6,6"/><Button Content="CLEAR" Click="ClearMask_Click" Padding="8" Margin="0,0,6,6"/><Button Content="INVERT" Click="InvertMask_Click" Padding="8" Margin="0,0,6,6"/><Button x:Name="EraseButton" Content="ERASE" Click="ToggleErase_Click" Padding="8" Margin="0,0,6,6"/></WrapPanel><TextBlock Text="Brush Size" Margin="0,8,0,0"/><Slider x:Name="BrushSize" Minimum="5" Maximum="300" Value="80" ValueChanged="BrushSetting_Changed"/><TextBlock Text="Feather"/><Slider x:Name="BrushFeather" Minimum="0" Maximum="100" Value="75" ValueChanged="BrushSetting_Changed"/><TextBlock Text="Flow"/><Slider x:Name="BrushFlow" Minimum="1" Maximum="100" Value="100" ValueChanged="BrushSetting_Changed"/>
<Separator Margin="0,20"/><TextBlock Text="MASK ADJUSTMENTS" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Mask Exposure"/><Slider x:Name="MaskExposure" Minimum="-2" Maximum="2" Value="0" ValueChanged="MaskSlider_Changed"/><TextBlock Text="Mask Contrast"/><Slider x:Name="MaskContrast" Minimum="-100" Maximum="100" Value="0" ValueChanged="MaskSlider_Changed"/><TextBlock Text="Mask Temperature"/><Slider x:Name="MaskTemperature" Minimum="-100" Maximum="100" Value="0" ValueChanged="MaskSlider_Changed"/><TextBlock Text="Mask Tint"/><Slider x:Name="MaskTint" Minimum="-100" Maximum="100" Value="0" ValueChanged="MaskSlider_Changed"/><TextBlock Text="Mask Saturation"/><Slider x:Name="MaskSaturation" Minimum="-100" Maximum="100" Value="0" ValueChanged="MaskSlider_Changed"/></StackPanel></ScrollViewer>
<Border Grid.Row="2" Grid.ColumnSpan="3" Background="#181818"><DockPanel Margin="16,0"><TextBlock x:Name="Status" Text="Ready" Foreground="#888" VerticalAlignment="Center"/><TextBlock Text="LumaLab • Windows" Foreground="#888" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
</Grid></Window>